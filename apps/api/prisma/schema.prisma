generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Auth ────────────────────────────────────────────

model User {
  id                          String    @id @default(uuid()) @db.Uuid
  email                       String    @unique
  passwordHash                String    @map("password_hash")
  nickname                    String?   @unique
  avatarUrl                   String?   @map("avatar_url")
  aboutMe                     String?   @map("about_me")
  role                        String    @default("user")
  subscription                String    @default("free")
  isDemo                      Boolean   @default(false) @map("is_demo")
  lang                        String    @default("en")
  emailVerified               Boolean   @default(false) @map("email_verified")
  verificationToken           String?   @unique @map("verification_token")
  verificationTokenExpiresAt  DateTime? @map("verification_token_expires_at")
  passwordResetToken          String?   @unique @map("password_reset_token")
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  deletedAt                   DateTime? @map("deleted_at")

  sessions         Session[]
  socialLinks      SocialLink[]
  chatProfiles     ChatProfile[]
  chatSessions     ChatSession[]
  usageCounters    UsageCounter[]
  aiJobs           AiJob[]
  usageLogs        UsageLog[]
  messageCopyAudit MessageCopyAudit[]
  likes            Like[]
  comments         Comment[]
  reports          Report[]
  following        Follow[]           @relation("follower")
  followers        Follow[]           @relation("followee")

  @@map("users")
}

// ─── Demo Limits ──────────────────────────────────────────────

model UsageCounter {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String   @map("user_id") @db.Uuid
  action  String // chat_message | stt | tts | generation
  count   Int      @default(0)
  resetAt DateTime @map("reset_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, action])
  @@map("usage_counters")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token")
  userAgent    String?  @map("user_agent")
  ip           String?
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model SocialLink {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  provider String
  url      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("social_links")
}

// ─── Chat Profiles (user-created personas) ───────────────────

model ChatProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  description String
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSessions ChatSession[]

  @@index([userId, deletedAt])
  @@map("chat_profiles")
}

// ─── Admin Settings (key-value store) ────────────────────────

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ─── Characters ──────────────────────────────────────────────

model Character {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  systemPrompt String    @map("system_prompt")
  personality  Json      @default("{}")
  avatarUrl    String?   @map("avatar_url")
  voiceId      String?   @map("voice_id")
  tags         String[]  @default([])
  isPublic     Boolean   @default(true) @map("is_public")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  chatSessions ChatSession[]
  comments     Comment[]
  reports      Report[]
  aiJobs       AiJob[]

  @@map("characters")
}

// ─── AutoGen (фоновая автогенерация персонажей в админке) ─────

model AutoGenTask {
  id           String    @id @default(uuid()) @db.Uuid
  // running | paused | completed | cancelled | stopped_no_balance | failed
  status       String    @default("running")
  total        Int
  succeeded    Int       @default(0)
  failed       Int       @default(0)
  params       Json      @default("{}") // ограничения рандома (на будущее)
  lastError    String?   @map("last_error")
  characterIds String[]  @default([]) @db.Uuid // созданные персонажи (для ссылок в UI)
  createdBy    String    @map("created_by") @db.Uuid // админ, запустивший задачу
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  finishedAt   DateTime? @map("finished_at")

  @@index([status])
  @@map("autogen_tasks")
}

// ─── Blog ────────────────────────────────────────────────────

model BlogPost {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  slug          String    @unique
  content       String // HTML из редактора (Tiptap), санитизирован на бэкенде
  excerpt       String? // meta description: заполняется вручную или автогенерится из тела
  category      String    @default("News") // News | Updates | AI | Relationship
  coverImageUrl String?   @map("cover_image_url")
  tags          String[]  @default([])
  isPublished   Boolean   @default(false) @map("is_published")
  publishedAt   DateTime? @map("published_at")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([isPublished, publishedAt(sort: Desc)])
  @@index([category])
  @@index([deletedAt])
  @@map("blog_posts")
}

// ─── Voices ──────────────────────────────────────────────────

model Voice {
  id        String   @id @default(uuid()) @db.Uuid
  name      String // отображаемое имя в Шаге 2 создания персонажа
  voiceId   String   @map("voice_id") // ElevenLabs voice id, используется при TTS
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, order])
  @@map("voices")
}

// ─── Chat ────────────────────────────────────────────────────

model ChatSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  characterId   String    @map("character_id") @db.Uuid
  chatProfileId String?   @map("chat_profile_id") @db.Uuid
  title         String?
  lastMessageAt DateTime? @map("last_message_at")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character    @relation(fields: [characterId], references: [id])
  chatProfile ChatProfile? @relation(fields: [chatProfileId], references: [id], onDelete: SetNull)
  messages    Message[]

  // Составной индекс для листа чатов: фильтр по userId + deletedAt, сортировка по lastMessageAt DESC
  @@index([userId, deletedAt, lastMessageAt(sort: Desc)])
  @@index([characterId])
  @@map("chat_sessions")
}

model Message {
  id            String    @id @default(uuid()) @db.Uuid
  chatSessionId String    @map("chat_session_id") @db.Uuid
  role          String // user | assistant | system
  content       String
  type          String    @default("text") // text | audio | image
  mediaUrl      String?   @map("media_url")
  metadata      Json?
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
  @@map("messages")
}

// ─── AI Jobs ─────────────────────────────────────────────────

model AiJob {
  id          String    @id @default(uuid()) @db.Uuid
  type        String // chat | stt | tts | image | video
  status      String    @default("pending") // pending | processing | completed | failed
  input       Json?
  output      Json?
  userId      String    @map("user_id") @db.Uuid
  // Персонаж, на основе которого сделана генерация (выбор существующего
  // персонажа на странице /generation). Позволяет показывать эти картинки в
  // сторис персонажа. Nullable: обычные генерации без персонажа и старые записи.
  characterId String?   @map("character_id") @db.Uuid
  tokensUsed  Int?      @map("tokens_used")
  error       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([characterId])
  @@map("ai_jobs")
}

// ─── Usage Logs ──────────────────────────────────────────────

model UsageLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  action     String // chat_message | stt | tts
  tokensUsed Int?     @map("tokens_used")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("usage_logs")
}

// ─── Character Options (image generation) ────────────────────

model CharacterOption {
  id              String   @id @default(cuid())
  category        String // STYLE | HUMAN_RACE | FANTASY_RACE | HAIR_STYLE | BODY_TYPE | BREAST_SIZE | BUTT_SIZE
  name            String
  prompt          String?
  imageUrl        String?  @map("image_url")
  imageThumbKey   String?  @map("image_thumb_key")
  imageFullKey    String?  @map("image_full_key")
  order           Int      @default(0)
  generationStyle String?  @map("generation_style")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("character_options")
}

// ─── Appearance Options (image generation) ───────────────────

model AppearanceCategory {
  id        String   @id @default(cuid())
  tab       String // OUTFITS | OUTFIT_DETAILS
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  options AppearanceOption[]

  @@index([tab])
  @@map("appearance_categories")
}

model AppearanceOption {
  id            String   @id @default(cuid())
  categoryId    String   @map("category_id")
  name          String
  prompt        String?
  imageUrl      String?  @map("image_url")
  imageThumbKey String?  @map("image_thumb_key")
  imageFullKey  String?  @map("image_full_key")
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  category AppearanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("appearance_options")
}

// ─── Pose Options (image generation) ─────────────────────────

model PoseCategory {
  id        String   @id @default(cuid())
  tab       String // FACIAL_EXPRESSION | POSE
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  options PoseOption[]

  @@index([tab])
  @@map("pose_categories")
}

model PoseOption {
  id            String   @id @default(cuid())
  categoryId    String   @map("category_id")
  name          String
  prompt        String?
  imageUrl      String?  @map("image_url")
  imageThumbKey String?  @map("image_thumb_key")
  imageFullKey  String?  @map("image_full_key")
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  category PoseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("pose_options")
}

// ─── Scene Options (image generation) ────────────────────────

model SceneCategory {
  id        String   @id @default(cuid())
  tab       String // LOCATION
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  options SceneOption[]

  @@index([tab])
  @@map("scene_categories")
}

model SceneOption {
  id            String   @id @default(cuid())
  categoryId    String   @map("category_id")
  name          String
  prompt        String?
  imageUrl      String?  @map("image_url")
  imageThumbKey String?  @map("image_thumb_key")
  imageFullKey  String?  @map("image_full_key")
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  category SceneCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("scene_options")
}

// ─── Camera Options (image generation) ───────────────────────

model CameraOption {
  id            String   @id @default(cuid())
  section       String // FRAMING | CAMERA_ANGLE
  name          String
  prompt        String?
  imageUrl      String?  @map("image_url")
  imageThumbKey String?  @map("image_thumb_key")
  imageFullKey  String?  @map("image_full_key")
  order         Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([section])
  @@map("camera_options")
}

// ─── Message Copy Audit ───────────────────────────────────────

model MessageCopyAudit {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("message_copy_audits")
}

// ─── Likes (polymorphic) ─────────────────────────────────────

model Like {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([userId])
  @@map("likes")
}

// ─── Follows ─────────────────────────────────────────────────

model Follow {
  id         String   @id @default(uuid()) @db.Uuid
  followerId String   @map("follower_id") @db.Uuid
  followeeId String   @map("followee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  follower User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("followee", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId])
  @@map("follows")
}

// ─── Comments ────────────────────────────────────────────────

model Comment {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  content     String
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, deletedAt])
  @@index([userId])
  @@map("comments")
}

// ─── Reports (жалобы на персонажей) ──────────────────────────

model Report {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  characterId String   @map("character_id") @db.Uuid
  reasons     String[] @default([])
  details     String?
  status      String   @default("open") // open | resolved
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@index([userId])
  @@index([createdAt])
  @@map("reports")
}
