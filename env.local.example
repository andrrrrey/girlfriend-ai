ENV=development

# Ports
WEB_PORT=3000
API_PORT=8080
AI_PORT=8081

# Core (localhost — for hybrid mode: infra in Docker, apps on host)
DATABASE_URL=postgresql://app:app@localhost:5433/app?schema=public
REDIS_URL=redis://localhost:6379/0
CLICKHOUSE_URL=http://localhost:8123

# S3 (dev: MinIO)
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=media

# Auth
JWT_SECRET=dev_secret_change_me
JWT_TTL_SECONDS=604800

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Request ID header
REQUEST_ID_HEADER=x-request-id

# PostHog product analytics — optional, disabled if empty (one key for api + web)
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Ключ шифрования секретов в БД (токены Telegram-ботов): openssl rand -base64 32
SECRETS_ENC_KEY=

# Общий секрет /internal/* (одинаковый в api, ai и worker): openssl rand -hex 32
# Пустое значение допустимо только при ENV=development или ENV=test
INTERNAL_API_TOKEN=

# Telegram: публичный HTTPS-адрес API для webhook (по умолчанию WEB_URL + /api-proxy)
TELEGRAM_WEBHOOK_BASE_URL=
# true — получать обновления polling-ом (локальная разработка без HTTPS)
TELEGRAM_POLLING=true
