ENV=development

# Ports
WEB_PORT=3000
API_HOST=api
API_PORT=8080
AI_HOST=ai
AI_PORT=8081

# Internal URL used by the web (Next.js) container to reach the API within Docker network
API_INTERNAL_URL=http://api:8080

# Core
DATABASE_URL=postgresql://app:app@postgres:5432/app?schema=public
REDIS_URL=redis://redis:6379/0
CLICKHOUSE_URL=http://clickhouse:8123

# S3 (dev: MinIO)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=media

# Auth
# REQUIRED: generate with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_SECONDS=604800

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Request ID header
REQUEST_ID_HEADER=x-request-id

# Email (Resend) — optional, emails are skipped if RESEND_API_KEY is not set
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com
# Public URL of the frontend, used in email verification links
WEB_URL=http://localhost:3000

# PostHog product analytics — optional, disabled if empty. ONE key for both api and web:
# - api (posthog-node) reads it directly;
# - web exposes it to the client at runtime via /api/config (read as plain env, not
#   NEXT_PUBLIC_, so it is never baked at build time — set it in the runtime env / stack).
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# AI Service Keys (stored in DB via Admin panel, but can override here for local dev)
# These are read from app_settings table at runtime; set them via Admin UI or seed
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_STT_MODEL=whisper-1
ELEVENLABS_API_KEY=...
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
